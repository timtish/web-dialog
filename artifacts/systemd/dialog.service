# /etc/systemd/system/dialog.service
# Один процесс FastAPI /dialog
[Unit]
Description=Dialog (FastAPI: API + static UI) on port 8011
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dialog
Group=dialog
WorkingDirectory=/opt/dialog
Environment=PORT=8011

# Секреты и параметры
EnvironmentFile=/opt/dialog/.env

ExecStart=/opt/dialog/.venv/bin/python artifacts/api-server/main.py

Restart=on-failure
RestartSec=5

# Журнал доступен через: journalctl -u dialog.service -f

[Install]
WantedBy=multi-user.target
